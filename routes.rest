@baseUrl = http://localhost:3000

### Health / root
GET {{baseUrl}}/

### Swagger docs (HTML)
GET {{baseUrl}}/api-docs/

### ----- AUTH -----
### Start GitHub OAuth login
GET {{baseUrl}}/api/auth/github

### Who am I (login state)
GET {{baseUrl}}/api/auth/me

### Logout
GET {{baseUrl}}/api/auth/logout

### ----- ARTISTS -----
### Get all artists (optional ?country=)
GET {{baseUrl}}/api/artists

### Get all artists from Spain
GET {{baseUrl}}/api/artists?country=Spain

### Get one artist by id
GET {{baseUrl}}/api/artists/6528a1b2c3d4e5f6a7b8c9d0

### Get all artworks of an artist
GET {{baseUrl}}/api/artists/6528a1b2c3d4e5f6a7b8c9d0/artworks

### Create artist (requires login)
POST {{baseUrl}}/api/artists
Content-Type: application/json

{
  "firstName": "Frida",
  "middleName": "",
  "lastName": "Kahlo",
  "birthDate": "1907-07-06",
  "deathDate": "1954-07-13",
  "country": "Mexico",
  "locality": "Coyoacan"
}

### Update artist (requires owner or admin)
PUT {{baseUrl}}/api/artists/6528a1b2c3d4e5f6a7b8c9d0
Content-Type: application/json

{
  "firstName": "Frida",
  "lastName": "Kahlo",
  "birthDate": "1907-07-06",
  "deathDate": "1954-07-13",
  "country": "Mexico",
  "locality": "Mexico City"
}

### Delete artist (requires owner or admin; 409 if it still has artworks)
DELETE {{baseUrl}}/api/artists/6528a1b2c3d4e5f6a7b8c9d0

### ----- ARTWORKS -----
### Get all artworks (optional ?period=&type=&year=&artistId=)
GET {{baseUrl}}/api/artworks

### Filter artworks by period and type
GET {{baseUrl}}/api/artworks?period=Baroque&type=Painting

### Advanced search: free text on the title
GET {{baseUrl}}/api/artworks/search?q=Two%20Fridas

### Advanced search: combine a text query with regular filters
GET {{baseUrl}}/api/artworks/search?q=landscape&period=Baroque&type=Painting

### Get one artwork by id
GET {{baseUrl}}/api/artworks/6528a1b2c3d4e5f6a7b8c9d1

### Get the keywords of an artwork
GET {{baseUrl}}/api/artworks/6528a1b2c3d4e5f6a7b8c9d1/keywords

### Create artwork (requires login)
POST {{baseUrl}}/api/artworks
Content-Type: application/json

{
  "title": "The Two Fridas",
  "year": 1939,
  "period": "Surrealism",
  "type": "Painting",
  "medium": "Oil on canvas",
  "dimensions": "173.5 cm x 173 cm",
  "description": "Double self-portrait.",
  "file": "https://example.com/two-fridas.jpg",
  "artistId": "6528a1b2c3d4e5f6a7b8c9d0"
}

### Update artwork (requires owner or admin)
PUT {{baseUrl}}/api/artworks/6528a1b2c3d4e5f6a7b8c9d1
Content-Type: application/json

{
  "title": "The Two Fridas",
  "description": "Updated description."
}

### Delete artwork (requires owner or admin; deletes its links too)
DELETE {{baseUrl}}/api/artworks/6528a1b2c3d4e5f6a7b8c9d1

### ----- KEYWORDS -----
### Get all keywords
GET {{baseUrl}}/api/keywords

### Get one keyword by id
GET {{baseUrl}}/api/keywords/6528a1b2c3d4e5f6a7b8c9d2

### Get all artworks tagged with a keyword
GET {{baseUrl}}/api/keywords/6528a1b2c3d4e5f6a7b8c9d2/artworks

### Create keyword (requires login)
POST {{baseUrl}}/api/keywords
Content-Type: application/json

{
  "keyword": "Surrealism"
}

### Update keyword (requires owner or admin)
PUT {{baseUrl}}/api/keywords/6528a1b2c3d4e5f6a7b8c9d2
Content-Type: application/json

{
  "keyword": "surrealism"
}

### Delete keyword (requires owner or admin; deletes its links too)
DELETE {{baseUrl}}/api/keywords/6528a1b2c3d4e5f6a7b8c9d2

### ----- ARTWORK-KEYWORDS -----
### Get all links (optional ?artworkId=&keywordId=)
GET {{baseUrl}}/api/artworkKeywords

### Get one link by id
GET {{baseUrl}}/api/artworkKeywords/6528a1b2c3d4e5f6a7b8c9d3

### Create link (requires login)
POST {{baseUrl}}/api/artworkKeywords
Content-Type: application/json

{
  "artworkId": "6528a1b2c3d4e5f6a7b8c9d1",
  "keywordId": "6528a1b2c3d4e5f6a7b8c9d2"
}

### Update link (requires owner or admin)
PUT {{baseUrl}}/api/artworkKeywords/6528a1b2c3d4e5f6a7b8c9d3
Content-Type: application/json

{
  "artworkId": "6528a1b2c3d4e5f6a7b8c9d1",
  "keywordId": "6528a1b2c3d4e5f6a7b8c9d4"
}

### Delete link (requires owner or admin)
DELETE {{baseUrl}}/api/artworkKeywords/6528a1b2c3d4e5f6a7b8c9d3

### ----- USERS (admin only) -----
### Get all users
GET {{baseUrl}}/api/users

### Get one user by id
GET {{baseUrl}}/api/users/6528a1b2c3d4e5f6a7b8c9d5

### Change a user's role (promote/demote)
PUT {{baseUrl}}/api/users/6528a1b2c3d4e5f6a7b8c9d5
Content-Type: application/json

{
  "role": "admin"
}

### Delete user
DELETE {{baseUrl}}/api/users/6528a1b2c3d4e5f6a7b8c9d5