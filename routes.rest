@baseUrl = http://localhost:3000

### Health / root
GET {{baseUrl}}/

### Swagger docs (HTML)
GET {{baseUrl}}/api-docs/

### ----- ARTISTS -----
### Get all artists
GET {{baseUrl}}/api/artists

### Get one artist by id
GET {{baseUrl}}/api/artists/6528a1b2c3d4e5f6a7b8c9d0

### Create artist (requires login)
POST {{baseUrl}}/api/artists
Content-Type: application/json

{
  "name": "Frida Kahlo",
  "bio": "Mexican painter known for self-portraits.",
  "nationality": "Mexican",
  "birthYear": 1907,
  "deathYear": 1954
}

### Update artist (requires login)
PUT {{baseUrl}}/api/artists/6528a1b2c3d4e5f6a7b8c9d0
Content-Type: application/json

{
  "name": "Frida Kahlo",
  "bio": "Mexican painter, updated bio.",
  "nationality": "Mexican",
  "birthYear": 1907,
  "deathYear": 1954
}

### Delete artist (requires admin)
DELETE {{baseUrl}}/api/artists/6528a1b2c3d4e5f6a7b8c9d0

### ----- ARTWORKS -----
### Get all artworks
GET {{baseUrl}}/api/artworks

### Get one artwork by id
GET {{baseUrl}}/api/artworks/6528a1b2c3d4e5f6a7b8c9d1

### Create artwork (requires login)
POST {{baseUrl}}/api/artworks
Content-Type: application/json

{
  "title": "The Two Fridas",
  "description": "Oil painting by Frida Kahlo.",
  "artistId": "6528a1b2c3d4e5f6a7b8c9d0",
  "year": 1939,
  "medium": "Oil on canvas",
  "imageUrl": "https://example.com/two-fridas.jpg"
}

### Update artwork (requires login)
PUT {{baseUrl}}/api/artworks/6528a1b2c3d4e5f6a7b8c9d1
Content-Type: application/json

{
  "title": "The Two Fridas",
  "description": "Updated description."
}

### Delete artwork (requires admin)
DELETE {{baseUrl}}/api/artworks/6528a1b2c3d4e5f6a7b8c9d1

