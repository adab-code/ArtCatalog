# ArtCatalog configuration example.
# Copy this file to ".env" and fill in your real values.

# Port the HTTP server listens on.
PORT=3000
# "development", "production" or "test". Sessions/passport are disabled in "test".
NODE_ENV=development
# Secret used to sign the session cookie. Use a long random string in production.
SESSION_SECRET=change_this_session_secret
# MongoDB connection string; the base name is the part after the last "/"
# (see DATABASE.md). Replace <username>/<password>/<cluster> with your Atlas data.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ArtCatalog
# GitHub OAuth application credentials (only used when the three GITHUB_* are set).
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# GitHub ids (comma separated) promoted to role "admin" on first login
# ADMIN_GITHUB_IDS=your_github_user_id_here